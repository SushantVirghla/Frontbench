# FrontBench Environment Configuration Example
# Copy to .env for local development

# API Service
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
ALLOW_ANONYMOUS_WRITES=true

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/frontbench

# CORS Origin
CORS_ORIGIN=http://localhost:5173
